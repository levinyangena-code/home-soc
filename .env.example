# Home SOC in a Box — Phase 1 foundation
# Copy this file to .env and replace every example value before deployment.

POSTGRES_DB=home_soc
POSTGRES_USER=home_soc
POSTGRES_PASSWORD=local-only-change-this-postgres-password

OPENSEARCH_ADMIN_PASSWORD=local-only-change-this-opensearch-password

# Bind the dashboard to loopback by default. Put it behind a VPN/reverse proxy
# with TLS before making it available beyond this machine.
UI_HOST=127.0.0.1
UI_PORT=8000
